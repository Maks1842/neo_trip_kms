# ============================================================
# Neo Trip CRM — пример файла окружения
# Скопировать в .env и заполнить реальными значениями:
#   cp .env.example .env
# Файл .env в git не попадает.
# ============================================================

# ---------- Приложение ----------
APP_NAME="Neo Trip CRM"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Источники, которым разрешены CORS-запросы (JSON-массив)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---------- PostgreSQL ----------
# Эти же переменные использует docker-compose для инициализации контейнера БД
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=neo_trip
POSTGRES_USER=neo_trip
# Вывод всех SQL-запросов в консоль: включать точечно при отладке
DB_ECHO=false

POSTGRES_PASSWORD=change_me_strong_password

# ---------- JWT ----------
# ОБЯЗАТЕЛЬНО заменить перед любым развёртыванием.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---------- Пагинация ----------
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# ---------- Первичное наполнение (скрипт scripts/seed.py) ----------
FIRST_COMPANY_NAME="Демо агентство"
FIRST_COMPANY_SLUG=demo
FIRST_ADMIN_EMAIL=admin@neotrip.ru
FIRST_ADMIN_PASSWORD=change_me_admin_password
FIRST_ADMIN_FULL_NAME="Администратор системы"
